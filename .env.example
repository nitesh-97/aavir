# ---------------------------------------------------------------------------
# On Vercel, the Neon and Blob integrations inject every one of these except
# AUTH_SECRET. For local development run `vercel env pull .env` to copy them
# down — Prisma's CLI reads .env specifically, not .env.local.
# ---------------------------------------------------------------------------

# Pooled Postgres connection, used at runtime.
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Direct (unpooled) connection. `prisma db push` and migrations need this;
# DDL through a connection pooler is unreliable. If your provider has no
# separate unpooled endpoint, set it to the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgres://user:password@host/db?sslmode=require"

# Signs the session cookie. MUST be set, and MUST be a long random string —
# the root layout reads the session on every request, so an unset value takes
# down every page. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Vercel Blob. When present, uploads go browser-direct to Blob storage; when
# absent, they fall back to writing into public/uploads for local development.
BLOB_READ_WRITE_TOKEN=""
